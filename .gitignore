# ==========================================
# Whitelist: Version 1_0_0 and Version 0_0_1
# ==========================================
/*
!.gitignore
!Version 1_0_0/
!Version 1_0_0/**
!Version 0_0_1/
!Version 0_0_1/**
!.github/
!.github/workflows/
!.github/workflows/**

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build outputs
build/
dist/
*.spec.bak
Version 0_0_1/build/
Version 0_0_1/dist/

# Logs
*.log
Version 1_0_0/agent/logs/

# IDE/editor
.obsidian/
.idea/
.vscode/

# Documentation excluded from v1
Version 1_0_0/agent/docs/

# Temporary files
*.bak
*.saved.bak
*backup*
*.zip
config.json
