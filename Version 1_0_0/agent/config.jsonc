{
  // ===== تنظیمات عمومی برنامه =====
  "app": {
    // نام منطقی سرویس/ایجنت برای لاگ و شناسایی داخلی
    "name": "KafkaAgent",

    // نسخه فعلی برنامه (همسو با مسیر مهاجرت شما)
    "version": "1.0.0",

    // فعال‌سازی مسیر canonical یعنی AgentWorker (پیشنهادی: true)
    "use_agent_worker": true,

    // تایم‌اوت polling در Worker بر حسب ثانیه
    "worker_poll_timeout_sec": 1.0,

    // سطح لاگ (DEBUG | INFO | WARNING | ERROR | CRITICAL)
    "log_level": "INFO",

    // مسیر فایل لاگ برنامه
    "log_file": "logs/agent.log",

    // زمان انتظار join در shutdown برای بسته‌شدن Thread اصلی runtime
    "shutdown_join_timeout_sec": 10.0
  },

  // نوع transport فعال (در این فاز: kafka)
  "transport": "kafka",

  // ===== تنظیمات Kafka =====
  "kafka": {
    // کلید فعال/غیرفعال کردن Kafka Runtime
    "enabled": true,

    // آدرس/آدرس‌های Kafka Broker (از ENV خوانده می‌شود)
    "bootstrap_servers": "${ENV:KAFKA_BOOTSTRAP_SERVERS}",

    // شناسه کلاینت Kafka (می‌تواند در runtime هم override شود)
    "client_id": "${ENV:KAFKA_CLIENT_ID}",

    // گروه مصرف‌کننده Kafka (ممکن است بعد از register با client_id اختصاصی rewrite شود)
    "group_id": "mt5_agent_group",

    // پروتکل امنیتی Kafka (PLAINTEXT / SASL_PLAINTEXT / SASL_SSL / SSL)
    "security_protocol": "PLAINTEXT",

    // مکانیزم SASL (در PLAINTEXT عملاً استفاده نمی‌شود، برای سازگاری نگه‌داشته شده)
    "sasl_mechanism": "PLAIN",

    // نام کاربری SASL (اگر پروتکل SASL فعال باشد)
    "sasl_username": "${ENV:KAFKA_SASL_USERNAME}",

    // رمز عبور SASL (اگر پروتکل SASL فعال باشد)
    "sasl_password": "${ENV:KAFKA_SASL_PASSWORD}",

    // بسیار مهم: برای commit semantics جدید باید false باشد (Application-managed commit)
    "enable_auto_commit": false,

    // استراتژی آفست اولیه وقتی آفست قبلی وجود ندارد (latest/earliest)
    "auto_offset_reset": "latest",

    // session timeout مصرف‌کننده Kafka بر حسب میلی‌ثانیه
    "session_timeout_ms": 30000,

    // حداکثر فاصله بین pollها قبل از revoke شدن consumer
    "max_poll_interval_ms": 300000,

    // ساختار canonical topicها برای command consume (الزامی برای worker path)
    "topics": {
      // لیست topicهای فرمان (سه اولویت/پارتیشن منطقی)
      "commands": [
        "agent.commands.p0",
        "agent.commands.p1",
        "agent.commands.p2"
      ]
    }
  },

  // ===== topicهای عمومی غیر از command =====
  "topics": {
    // topic پاسخ‌ها (producer سمت agent)
    "response": "agent.responses",

    // topic heartbeat برای health/liveness
    "heartbeat": "agent.heartbeats",

    // topic dead-letter برای پیام‌های شکست‌خورده/غیرقابل پردازش
    "dlq": "agent.dead_letter"
  },

  // ===== تنظیمات احراز هویت سطح برنامه =====
  "auth": {
    // فعال/غیرفعال بودن مکانیزم auth داخلی
    "enabled": false,

    // client id برای auth داخلی (در صورت فعال بودن)
    "client_id": "${ENV:AGENT_AUTH_CLIENT_ID}",

    // secret برای HMAC (در صورت فعال بودن auth)
    "hmac_secret": "${ENV:AGENT_HMAC_SECRET}",

    // الگوریتم HMAC
    "algorithm": "sha256"
  },

  // ===== تنظیمات MetaTrader =====
  "metatrader": {
    // مسیر اجرایی ترمینال MT5 در ویندوز
    "path": "C:\\Program Files\\MetaTrader 5\\terminal64.exe",

    // لاگین حساب (0 یعنی unset)
    "login": 0,

    // نام سرور بروکر
    "server": "",

    // تایم‌اوت عملیات MT5 بر حسب میلی‌ثانیه
    "timeout_ms": 60000,

    // اجرای portable mode
    "portable": false
  },

  // ===== تنظیمات پایداری/Idempotency (canonical برای main.py) =====
  "persistence": {
    // مسیر دیتابیس SQLite برای idempotency/spool
    "idempotency_db_path": "data/idempotency.db",

    // TTL رکوردهای idempotency بر حسب ثانیه (مثلاً 24 ساعت)
    "idempotency_ttl_seconds": 86400,

    // TTL رکوردهای in-progress بر حسب ثانیه
    "idempotency_in_progress_ttl_seconds": 300
  },

  // ===== تنظیمات reliability عمومی =====
  "reliability": {
    // آستانه circuit breaker
    "circuit_breaker_threshold": 5,

    // زمان recovery circuit breaker بر حسب ثانیه
    "circuit_breaker_recovery_sec": 30
  }
}
